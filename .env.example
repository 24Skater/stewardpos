# StewardPOS — frontend configuration
#
# Copy to `.env.local` and edit. This file covers the **browser bundle only**.
# The API is configured separately, in `backend/.env` — see `backend/env.example`
# and `docs/reference/environment.md`.
#
# ---------------------------------------------------------------------------
# Read this before adding anything
# ---------------------------------------------------------------------------
# Vite inlines every `VITE_`-prefixed value into the JavaScript it ships. They
# are not secrets and cannot be made into secrets: anyone who loads the app can
# read them with View Source.
#
# So nothing here is a password, a token, or a connection string. If you find
# yourself wanting to add one, it belongs in `backend/.env`, where it stays on
# the server.
#
# An earlier version of this file got that wrong. It listed forty-three
# variables — including `VITE_DB_PASSWORD`, `VITE_AUTH_CLIENT_SECRET` and
# `VITE_SMS_TWILIO_AUTH_TOKEN` — from the era when this was a browser-only app
# with no server. Every one of them had stopped being read; filling them in
# would have published a database password to every visitor. The four below are
# what the code actually looks for.

# ---------------------------------------------------------------------------
# Where the API is
# ---------------------------------------------------------------------------
# Leave empty for same-origin `/api` requests. That is what you want when the
# frontend is served through the same proxy as the API — including local
# development, where Vite proxies `/api` for you, and the Docker stack, where
# nginx does.
#
# Set an absolute URL only when the browser must reach the API on a different
# origin, and then add that origin to the backend's `CORS_ORIGIN` or every
# request will be refused at preflight.
#
# Because the value is baked in at build time, changing it means rebuilding —
# it cannot be set at container start.
VITE_API_BASE_URL=

# Where `npm run dev` proxies `/api`. Only used by the dev server; it never
# reaches the bundle. Default: http://localhost:3002
# VITE_DEV_API_PROXY_TARGET=http://localhost:3002

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Which database the setup wizard pre-selects: postgres | sqlite.
# Only a default for the form — the backend decides what it actually connects
# to, via DB_ADAPTER. Default: postgres
# VITE_DB_ADAPTER=postgres

# Show the seeded demo credentials on the login screen. For the public demo
# deployment only; never set this on a real install. Default: false
# VITE_DEMO_MODE=false

# Browser console verbosity: error | warn | info | debug. Default: info
# VITE_LOG_LEVEL=info
