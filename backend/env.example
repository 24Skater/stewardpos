# =============================================================================
# StewardPOS Backend Configuration
# =============================================================================
# Copy this file to .env and update with your values
# DO NOT commit .env to version control

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# -----------------------------------------------------------------------------
# JWT Configuration
# -----------------------------------------------------------------------------
# IMPORTANT: Generate a secure random string (minimum 32 characters)
# You can use: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-32-chars
JWT_EXPIRES_IN=7d

# -----------------------------------------------------------------------------
# Payment Credential Encryption
# -----------------------------------------------------------------------------
# Encrypts the payment-processor keys stored in Settings, so a copy of the
# database — or a backup of it — is not enough to use them.
#
# Strongly recommended anywhere, and effectively required if you host StewardPOS
# for somebody else: the key in that database is *their* Stripe key, and a
# leaked backup would be a full account takeover of their payment account.
#
# Generate with: openssl rand -base64 32
#
# Keep it. Without this value the stored credentials cannot be read back, and
# card payments stop until they are re-entered in Settings. Back it up wherever
# you back up JWT_SECRET, and not in the same place as the database.
#
# Already have credentials saved? Set this, then run, in `backend/`:
#   npm run encrypt-credentials
# CREDENTIALS_KEY=

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
# Choose adapter: 'postgres' or 'sqlite'
DB_ADAPTER=sqlite

# PostgreSQL Configuration (if DB_ADAPTER=postgres)
# ⚠️ IMPORTANT: Change these values in production!
DB_HOST=localhost
DB_PORT=5432
DB_NAME=stewardpos
DB_USER=postgres
DB_PASSWORD=CHANGE_THIS_PASSWORD

# SQLite Configuration (if DB_ADAPTER=sqlite)
# Path to SQLite database file (will be created if it doesn't exist)
DB_FILENAME=./data/stewardpos.db

# -----------------------------------------------------------------------------
# CORS Configuration
# -----------------------------------------------------------------------------
# Comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
# Sized from the real app: opening the register costs ~24 API calls and each
# sale adds ~3. Every terminal in a shop shares one public IP, so the old
# value of 100 allowed roughly 25 sales per window for the whole store.
RATE_LIMIT_MAX_REQUESTS=3000
# Failed sign-ins per window per IP. Successful ones are not counted.
RATE_LIMIT_MAX_LOGIN_ATTEMPTS=10
# The same treatment for the three endpoints that take a code or a PIN typed at
# a terminal anyone can walk up to. Successes are not counted, so a shift change
# where six cashiers sign on in a row spends nothing.
#   pair      POST /api/registers/pair          mints a device credential, no session required
#   shift     POST /api/registers/:id/shifts    a six-digit cashier PIN
#   override  POST /api/registers/:id/overrides a supervisor PIN, same public keypad
RATE_LIMIT_MAX_PAIR_ATTEMPTS=10
RATE_LIMIT_MAX_SHIFT_ATTEMPTS=10
RATE_LIMIT_MAX_OVERRIDE_ATTEMPTS=10

# How many reverse proxies sit in front of this app.
#
# Rate limiting keys on the client IP, and Express only reads X-Forwarded-For
# when told how far to trust it. Left at 0 behind a proxy, every request appears
# to come from the proxy: the whole internet shares one bucket and one abusive
# client can lock out the shop, sign-in included.
#
# It defaults to 0 because the opposite mistake is worse — trusting the header
# when nothing sets it lets any client spoof its address and skip the limits
# entirely. Set it to the number of proxies you actually run (the shipped Docker
# stack is 1).
TRUST_PROXY=0

# -----------------------------------------------------------------------------
# Logging Configuration
# -----------------------------------------------------------------------------
LOG_LEVEL=info
LOG_FILE=./logs/app.log
# Rotation. Total on disk is LOG_MAX_SIZE_MB x LOG_MAX_FILES, so the defaults
# below cap it at 100 MB; without these the file grows for the life of the
# install and eventually fills the volume.
LOG_MAX_SIZE_MB=20
LOG_MAX_FILES=5

# -----------------------------------------------------------------------------
# Security Configuration
# -----------------------------------------------------------------------------
# bcrypt cost factor for passwords, PINs, device tokens and override grants.
# Accepted range is 10-15; the cost doubles with every round. Safe to raise on a
# running install: bcrypt stores the cost inside each hash, so existing
# credentials keep verifying and only new ones use the new value.
BCRYPT_ROUNDS=10

# Failed password sign-ins before an account locks, and for how long (ms).
#
# The rate limits above count per IP, so on their own they stop nobody with a
# few hundred addresses from grinding at one account. This is the per-account
# half. A manager can clear a lockout immediately from Admin -> Roles & Users,
# which is what keeps it from being a denial-of-service handle for anyone who
# knows a colleague's email address.
#
# Ten rather than the PIN's five: a long password is simply more mistypeable
# than a six-digit code. Defaults: 10 attempts, 15 minutes.
# PASSWORD_MAX_FAILURES=10
# PASSWORD_LOCKOUT_MS=900000

# -----------------------------------------------------------------------------
# Uploads
# -----------------------------------------------------------------------------
# Where logos, favicons and product images are stored.
#
#   localstorage  the ./uploads directory on this machine (a Docker volume in
#                 the shipped stack). Correct until you run more than one
#                 backend, at which point a file written by one is invisible to
#                 the others.
#   s3            any S3-compatible bucket: Amazon's, or the MinIO container in
#                 docker-compose.yml.
#
# Either way the API serves images from /uploads/..., so switching does not
# invalidate URLs already saved against settings and products, and the bucket
# does not need to be public.
STORAGE_ADAPTER=localstorage

# Only read when STORAGE_ADAPTER=s3. The endpoint is for S3-compatible servers;
# leave it unset for Amazon S3 itself.
# S3_ENDPOINT=http://minio:9000
# S3_REGION=us-east-1
# S3_BUCKET=stewardpos
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
#
# A production install with STORAGE_ADAPTER=s3 will not boot without a real
# S3_SECRET_ACCESS_KEY, and the bucket is checked at startup rather than on the
# first upload.

# -----------------------------------------------------------------------------
# Email
# -----------------------------------------------------------------------------
# Used for emailing receipts. All three adapters are implemented.
#
#   console  writes the message to the server log and reports the send as
#            "logged" rather than "sent", so receipt history never claims a
#            customer was emailed when nothing left the building
#   smtp     any SMTP server; set SMTP_HOST and the rest below
#   resend   the Resend API; set EMAIL_RESEND_API_KEY
EMAIL_ADAPTER=console
EMAIL_FROM=noreply@stewardpos.local

# When EMAIL_ADAPTER=smtp. Leave SMTP_USER unset for an anonymous relay.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=

# When EMAIL_ADAPTER=resend.
# EMAIL_RESEND_API_KEY=re_...

# -----------------------------------------------------------------------------
# Payment terminals
# -----------------------------------------------------------------------------
# Which provider is in use is a store setting, chosen in Settings -> Payments.
# These are the credentials for it, kept here rather than in the database so a
# key never sits in a backup or a settings export.
#
# A provider's key can also be saved through the admin UI; this environment
# variable takes precedence when both are present.
#
# Card payments are simulated unless a real provider is configured and its
# hardware is present. See docs/masterplan/phase-3-checkout-payments.md.
# STRIPE_SECRET_KEY=sk_live_...
# SQUARE_ACCESS_TOKEN=
# CLOVER_API_TOKEN=
# VERIFONE_API_KEY=
# DEJAVOO_API_KEY=
