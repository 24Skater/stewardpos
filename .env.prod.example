# StewardPOS — production environment.
#
#   cp .env.prod.example .env
#   # fill in the values below
#   docker compose -f docker-compose.prod.yml up -d
#
# Generate every secret. Do not edit the placeholders into something that looks
# secret — generate them:
#
#   openssl rand -base64 32
#
# The backend refuses to start in production if it finds a secret this
# repository ships, so a skipped line fails loudly at boot rather than quietly
# for the life of the install.
#
# This file becomes `.env`, which is gitignored. Keep a copy of the filled
# version somewhere safe: losing JWT_SECRET signs everyone out, and losing
# POSTGRES_PASSWORD locks you out of your own database.

# ---------------------------------------------------------------------------
# Public identity
# ---------------------------------------------------------------------------

# The hostname customers and staff will type. Must already resolve (an A or AAAA
# record) to this server, or Caddy cannot obtain a certificate.
DOMAIN=pos.example.org

# Let's Encrypt sends certificate-expiry warnings here. A real mailbox someone
# reads — it is the only warning you get before a cert lapses.
ACME_EMAIL=admin@example.org

# ---------------------------------------------------------------------------
# Secrets — generate all four
# ---------------------------------------------------------------------------

# Signs session tokens. Changing it later signs every user out.
# openssl rand -base64 32
JWT_SECRET=

# openssl rand -base64 32
POSTGRES_PASSWORD=

# Object storage. Only used if you serve uploads from MinIO; the default disk
# path works without it, but the container still needs credentials to start.
MINIO_ROOT_USER=stewardpos
# openssl rand -base64 32
MINIO_ROOT_PASSWORD=

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

POSTGRES_DB=stewardpos
POSTGRES_USER=stewardpos_user
MINIO_BUCKET=stewardpos

# Run a published image instead of building from source. Leave unset and the
# stack builds locally, which works and takes a few minutes of CPU on what is
# often the shop's only server.
#
#   IMAGE_TAG=1.0.0-rc.1
#
# Pinning is the better habit: it is what makes a rollback a one-line change.
# See docs/guides/upgrade.md.
# IMAGE_TAG=1.0.0-rc.1

# How long a sign-in lasts. Shorter is safer; a till that signs itself out
# mid-shift is its own kind of problem.
JWT_EXPIRES_IN=24h

# info while bedding in, warn once it is quiet.
LOG_LEVEL=info

# Rate limiting, per client address, across the whole API.
#
# 3000 per 15 minutes is sized from measurement: opening the register costs
# about 24 API calls and each sale adds about 3, and every terminal in a shop
# shares one public IP. The old default of 100 allowed roughly 25 sales per
# quarter-hour for an entire store.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=3000
# Failed sign-ins only, so a shift change costs nothing.
RATE_LIMIT_MAX_LOGIN_ATTEMPTS=10

# ---------------------------------------------------------------------------
# Email — receipts
# ---------------------------------------------------------------------------
#
# Left as `console`, receipt emails are written to the backend log and not sent.
# The app says so rather than claiming delivery, but customers get nothing.
# Set this up before you rely on emailed receipts.

EMAIL_ADAPTER=console
# EMAIL_ADAPTER=smtp
# EMAIL_FROM=receipts@example.org
# SMTP_HOST=smtp.example.org
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
